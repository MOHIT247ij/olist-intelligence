# Copy to .env and fill in

# PostgreSQL (leave empty to use local SQLite file data/olist.db)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/olist

# Read-only DB user for the AI NL->SQL feature (recommended). Falls back to DATABASE_URL.
DATABASE_URL_READONLY=postgresql+psycopg2://olist_reader:reader_pw@localhost:5432/olist

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Business assumptions (Olist has no cost data -> profit is ESTIMATED)
ASSUMED_GROSS_MARGIN=0.35
CHURN_WINDOW_DAYS=180
