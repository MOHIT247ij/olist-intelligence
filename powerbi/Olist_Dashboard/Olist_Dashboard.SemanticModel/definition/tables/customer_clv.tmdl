table customer_clv
	lineageTag: 245bb690-6a2c-4ec1-8a00-7e37e482ab1a

	measure 'Avg CLV' = AVERAGE ( customer_clv[total_clv] )
		formatString: \R$ #,0
		lineageTag: 2b4ef5b1-23f6-444b-897a-f10429240275

	column customer_unique_id
		dataType: string
		lineageTag: bdf726ae-9b53-479c-8f9b-05d00bc2cded
		summarizeBy: none
		sourceColumn: customer_unique_id

	column total_clv
		dataType: double
		lineageTag: ab1794c7-3a8f-424d-b086-f0ea97cf93d9
		summarizeBy: none
		sourceColumn: total_clv

	column clv_tier
		dataType: string
		lineageTag: 7a4857be-a219-4741-a69c-1f9a5a7e2d75
		summarizeBy: none
		sourceColumn: clv_tier

	partition customer_clv = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "customer_clv.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"customer_unique_id", "total_clv", "clv_tier"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"customer_unique_id", type text}, {"total_clv", type number}, {"clv_tier", type text}}, "en-US")
				in
				    Typed

