table dim_product
	lineageTag: edee674e-5992-4c6a-b945-b006da32d5b8

	column product_id
		dataType: string
		lineageTag: afcf353f-4295-4dc3-b887-f30e4402847b
		summarizeBy: none
		sourceColumn: product_id

	column category
		dataType: string
		lineageTag: ceb65420-f509-47dd-8c68-d0013648a706
		summarizeBy: none
		sourceColumn: category

	partition dim_product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"product_id", "category"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"product_id", type text}, {"category", type text}}, "en-US")
				in
				    Typed

