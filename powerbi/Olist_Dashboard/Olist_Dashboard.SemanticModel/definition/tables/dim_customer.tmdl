table dim_customer
	lineageTag: 61ef6e02-84fc-4ac1-a679-c9dddc941b5c

	column customer_unique_id
		dataType: string
		lineageTag: addec03a-7437-4417-bd3d-6ea730a86fd2
		summarizeBy: none
		sourceColumn: customer_unique_id

	column city
		dataType: string
		lineageTag: 36505ee6-cc1e-4bf6-af0e-4feaa5f2722c
		summarizeBy: none
		sourceColumn: city

	column state
		dataType: string
		lineageTag: 777d328f-fdd4-4733-8cbd-b998eea1bf9d
		summarizeBy: none
		sourceColumn: state

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"customer_unique_id", "city", "state"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"customer_unique_id", type text}, {"city", type text}, {"state", type text}}, "en-US")
				in
				    Typed

