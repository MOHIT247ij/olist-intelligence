table agg_revenue_anomalies
	lineageTag: fc8b66fa-046d-4d9f-abb9-897b5bc29697

	column week
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: d0909934-7f3d-4d28-a0f0-ab67518df1b8
		summarizeBy: none
		sourceColumn: week

	column revenue
		dataType: double
		lineageTag: 7b1fd2b9-31b2-43f1-af69-2e6afc4818df
		summarizeBy: none
		sourceColumn: revenue

	column expected
		dataType: double
		lineageTag: a6ea8fe8-31d9-48d0-8e12-63372cdbb8de
		summarizeBy: none
		sourceColumn: expected

	column change_pct
		dataType: double
		lineageTag: 9d0200e4-9b3f-4944-8d39-6e6785182abe
		summarizeBy: none
		sourceColumn: change_pct

	column alert
		dataType: string
		lineageTag: 1eb850cf-1147-40a0-b273-9c4357f26c3f
		summarizeBy: none
		sourceColumn: alert

	partition agg_revenue_anomalies = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "agg_revenue_anomalies.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"week", "revenue", "expected", "change_pct", "alert"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"week", type date}, {"revenue", type number}, {"expected", type number}, {"change_pct", type number}, {"alert", type text}}, "en-US"),
				    Alerts = Table.SelectRows(Typed, each [alert] <> null and [alert] <> "")
				in
				    Alerts

