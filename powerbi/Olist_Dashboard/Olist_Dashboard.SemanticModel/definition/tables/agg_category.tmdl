table agg_category
	lineageTag: ff0bf6b8-199f-4a2a-acad-b8796b175ead

	measure 'Category Revenue' = SUM ( agg_category[revenue] )
		formatString: \R$ #,0.00,,\M
		lineageTag: 9bbe1cb2-82a3-4e17-81a3-077158639906

	measure 'Cumulative Share %' = DIVIDE ( MAX ( agg_category[cumulative_share_pct] ), 100 )
		formatString: 0%
		lineageTag: 2b3d3dee-5ca7-43de-9260-54c8b4b34e60

	measure 'Avg Category Price' = AVERAGE ( agg_category[avg_price] )
		formatString: \R$ #,0
		lineageTag: 00e520fe-1075-4b98-bb2c-71817d7cfa57

	measure 'Avg Category Review' = AVERAGE ( agg_category[avg_review] )
		formatString: 0.00
		lineageTag: a34114b4-9e7d-4754-bf4f-a4a0526ac51b

	measure 'Category Count' = DISTINCTCOUNT ( agg_category[category] )
		formatString: #,0
		lineageTag: aaf4dbb5-91b4-485a-aa83-8201d5b7a90d

	measure 'Top Category Share %' = DIVIDE ( MAX ( agg_category[revenue_share_pct] ), 100 )
		formatString: 0.0%
		lineageTag: aa56ef79-68be-4e1d-8a6e-3e0820c06126

	column category
		dataType: string
		lineageTag: 0b48c476-16bb-4f60-979e-2be7158d5074
		summarizeBy: none
		sourceColumn: category

	column revenue
		dataType: double
		lineageTag: 87f7be56-9597-41bc-a2f9-ed2e22868ea9
		summarizeBy: none
		sourceColumn: revenue

	column avg_price
		dataType: double
		lineageTag: 9abc4d09-731a-4ec6-a709-91ec646d715b
		summarizeBy: none
		sourceColumn: avg_price

	column avg_review
		dataType: double
		lineageTag: 4318223f-5059-4e2b-a8b7-4120defacadb
		summarizeBy: none
		sourceColumn: avg_review

	column revenue_share_pct
		dataType: double
		lineageTag: 08f3aabb-2a9a-4cba-a0b5-10ca9dcd651d
		summarizeBy: none
		sourceColumn: revenue_share_pct

	column cumulative_share_pct
		dataType: double
		lineageTag: f7c5f222-e490-43bc-8357-573711bd5a48
		summarizeBy: none
		sourceColumn: cumulative_share_pct

	partition agg_category = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "agg_category.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"category", "revenue", "avg_price", "avg_review", "revenue_share_pct", "cumulative_share_pct"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"revenue", type number}, {"avg_price", type number}, {"avg_review", type number}, {"revenue_share_pct", type number}, {"cumulative_share_pct", type number}}, "en-US")
				in
				    Typed

