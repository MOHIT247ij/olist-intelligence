table agg_sentiment_month
	lineageTag: 0fdfe2ef-a69b-4dde-bd91-870a8a7cabbf

	measure 'Positive %' = DIVIDE ( SUM ( agg_sentiment_month[positive_pct] ), 100 )
		formatString: 0%
		lineageTag: b513a9f3-d7a9-452e-8437-c9295b9d2fc6

	measure 'Neutral %' = DIVIDE ( SUM ( agg_sentiment_month[neutral_pct] ), 100 )
		formatString: 0%
		lineageTag: 0b08342a-1155-41b4-9dff-021cc0ef36c3

	measure 'Negative %' = DIVIDE ( SUM ( agg_sentiment_month[negative_pct] ), 100 )
		formatString: 0%
		lineageTag: 36cd5fc5-99e1-46b3-b6e7-0bce27e1be97

	column review_month
		dataType: string
		lineageTag: 513cf833-c780-44dc-aacf-fc6a0668459d
		summarizeBy: none
		sourceColumn: review_month

	column positive_pct
		dataType: double
		lineageTag: d824731a-b6dc-4039-abe2-ed7a60976e1b
		summarizeBy: none
		sourceColumn: positive_pct

	column neutral_pct
		dataType: double
		lineageTag: 1a0d26d3-9188-4534-8c36-b470af8ece5d
		summarizeBy: none
		sourceColumn: neutral_pct

	column negative_pct
		dataType: double
		lineageTag: af3c135e-886e-4ef4-959b-c64cdb7f34f6
		summarizeBy: none
		sourceColumn: negative_pct

	partition agg_sentiment_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "agg_sentiment_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"review_month", "positive_pct", "neutral_pct", "negative_pct"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"review_month", type text}, {"positive_pct", type number}, {"neutral_pct", type number}, {"negative_pct", type number}}, "en-US")
				in
				    Typed

